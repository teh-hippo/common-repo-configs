{
  // Shared Renovate base preset for all teh-hippo repositories.
  // See README.md for the policy summary and per-repo slot allocation.
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  extends: [
    "config:best-practices",
    ":enableVulnerabilityAlertsWithLabel(security)",
    ":semanticCommits",
    ":rebaseStalePrs",
  ],

  timezone: "Australia/Sydney",
  labels: ["dependencies"],

  // Renovate-managed automerge, deliberately not GitHub's native auto-merge. Native
  // auto-merge gates only on the branch protection required checks, and several repositories
  // here require a subset of their CI (dwerty requires none at all), so it can and does merge
  // before the real tests finish. Renovate's own automerge requires every check to be green,
  // which is the safe behaviour for this estate. The stray pending check that once stalled
  // lock-file maintenance is fixed at its source below, so it no longer needs working around.
  automerge: true,
  platformAutomerge: false,

  // Off by design: cosmetic for a fully-autonomous estate, and blind to transitive-lockfile
  // CVEs anyway (its OSV summary is direct-deps-only). The signal is GitHub's Dependabot alert.
  dependencyDashboard: false,

  // Broaden vulnerability detection beyond GHSA (covers PyPI / Go / Cargo earlier).
  osvVulnerabilityAlerts: true,

  // Let researchers detect bad releases (supply-chain attacks, broken publishes) before we adopt them.
  // best-practices already enforces this for npm; we extend the principle to every ecosystem.
  // Vulnerability PRs, pins/digests and lock-file maintenance opt out below.
  minimumReleaseAge: "3 days",

  // Harmless on non-forks; required for forks (foxess-ha, icloud_photos_downloader).
  forkProcessing: "enabled",

  // Default: dep updates are housekeeping and must not cut a release.
  // Overridden below for runtime deps so end-users actually receive the fix.
  semanticCommitScope: "deps",
  semanticCommitType: "chore",

  customManagers: [
    {
      customType: "regex",
      description: "Update explicitly annotated tools installed by workflow run steps.",
      managerFilePatterns: ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+run: npx --yes --package \\S+@(?<currentValue>\\S+) --",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+run: cargo install \\S+ --version (?<currentValue>\\S+) --locked",
      ],
    },
  ],

  // Transitive CVEs live only in the lock file and Renovate cannot target them directly;
  // a DAILY relock is the vanilla, autonomous path that clears them (overrides
  // best-practices' weekly lock-file maintenance). Applies to uv.lock, Cargo.lock, etc.
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 6am"],
    automerge: true,
    // A relock has no single release behind it, so it carries no release timestamp. Since
    // Renovate 42 a missing timestamp counts as "not yet aged", which pins the
    // renovate/stability-days check yellow forever and blocks the merge permanently.
    minimumReleaseAge: null,
  },

  packageRules: [
    {
      description: "Runtime deps trigger a patch release so downstream users receive the update.",
      matchDepTypes: [
        "dependencies",
        "require",
        "optionalDependencies",
        "peerDependencies",
      ],
      semanticCommitType: "fix",
    },
    {
      description: "Reusable-workflow dependency updates trigger a patch release for immutable consumers.",
      matchFileNames: [
        ".github/workflows/mdbook.yml",
        ".github/workflows/rust-release.yml",
        ".github/workflows/security-audit.yml",
      ],
      semanticCommitType: "fix",
    },
    {
      description: "Cargo: keep bumps lock-file-only so a stray range never forces manifest churn.",
      matchManagers: ["cargo"],
      rangeStrategy: "update-lockfile",
    },
    {
      description: "Pin and digest updates carry no new source, so the release-age soak only stalls them (a rebuilt tag re-pins a fresh digest and resets the clock forever). Merge as soon as CI is green.",
      matchUpdateTypes: ["pin", "pinDigest", "digest"],
      minimumReleaseAge: null,
    },
    {
      description: "Replacements carry no release timestamp (renovatebot/renovate#39400), so the soak would stall them forever exactly as it did lock-file maintenance. The inherited npm-scoped carve-out does not cover the other ecosystems.",
      matchUpdateTypes: ["replacement"],
      minimumReleaseAge: null,
    },
  ],

  // Security lands immediately, ungrouped, and auto-merges on its own green CI, so a
  // routine or lock-file PR failure can never block a security fix.
  vulnerabilityAlerts: {
    minimumReleaseAge: null,
    automerge: true,
  },
}
